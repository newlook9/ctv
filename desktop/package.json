{
  "name": "livetv-desktop",
  "version": "1.1.0",
  "description": "Live TV and Radio for Windows",
  "author": "LiveTV",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "hls.js": "^1.5.8"
  },
  "build": {
    "appId": "com.livetv.desktop",
    "productName": "Live TV",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "artifactName": "LiveTV-Setup-${version}.exe",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Live TV"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ]
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  }
}